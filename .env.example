# Copia este archivo como ".env" en la raíz del proyecto y completa
# cada valor con los datos de TU proyecto de Firebase.
# NUNCA subas el archivo ".env" real al repositorio (ya está en .gitignore).
#
# Dónde obtener estos valores:
# 1. Ve a https://console.firebase.google.com
# 2. Entra a tu proyecto (o crea uno nuevo)
# 3. Ve a "Configuración del proyecto" (ícono de engranaje) > "General"
# 4. Baja hasta "Tus apps" > selecciona la app web (o crea una con "</>")
# 5. Copia los valores del objeto firebaseConfig a las variables de abajo

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
